# Set these on your backend host, not in Netlify frontend variables.
SPRING_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=<generate-a-long-random-secret>
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-unique-password>
INGEST_PASSWORD=<strong-unique-password>
ALLOWED_ORIGINS=https://your-site.netlify.app
OLLAMA_ENABLED=false
# Optional if running ingestion service separately:
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
CORE_API_URL=https://your-core-api.example.com
INGEST_TRIGGER_KEY=<strong-random-key>
